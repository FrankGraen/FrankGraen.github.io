---
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PublicationMeta from "./PublicationMeta.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { resolveLinkIcon } from "@/utils/projects-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	title: string;
	authors: { name: string; marker?: string }[];
	venue: string;
	authorNotes?: string;
	description?: string;
	image: string;
	basePath?: string;
	link?: { label: string; icon: string; value: string }[];
}

const { id, title, authors, venue, authorNotes, description, image, basePath = "/", link = [] } = Astro.props;
const detailUrl = url(`/projects/${id}/`);
---

<article class="project-card project-card-list card-base">
	{image && (
		<a href={detailUrl} class="project-card-image" aria-label={title}>
			<CoverImage src={image} basePath={basePath} alt={title} class="w-full h-full" preview={false} />
		</a>
	)}
	<div class="project-card-content">
		<h2 class="post-card-title text-90">
			<a href={detailUrl}>{title}</a>
		</h2>
		<PublicationMeta authors={authors} venue={venue} authorNotes={authorNotes} />
		{description && <p class="description text-75">{description}</p>}
		<div class="project-links">
			{link.map((resource) => {
				const icon = resolveLinkIcon(resource.icon, resource.label);
				return (
					<a href={resource.value} target="_blank" rel="noopener noreferrer" class="resource-link">
						{icon.kind === "icon" && <Icon name={icon.value} class="text-base" />}
						{icon.kind === "image" && <img src={icon.value} alt="" width="16" height="16" loading="lazy" />}
						{resource.label}
					</a>
				);
			})}
			<a href={detailUrl} class="detail-link text-50">
				{i18n(I18nKey.projectDetails)}
				<Icon name="material-symbols:chevron-right-rounded" class="text-base" />
			</a>
		</div>
	</div>
</article>

<style>
	.project-card { display: grid; grid-template-columns: 1fr; gap: 1.25rem; padding: 1.25rem; border-radius: 8px; min-width: 0; }
	.project-card-image { display: block; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px; align-self: start; }
	.project-card-image :global(img) { object-fit: contain; }
	.project-card-image :global(.cover-image-container) { min-height: 0; }
	.project-card-content { display: flex; flex-direction: column; gap: 0.65rem; min-width: 0; }
	.post-card-title { margin: 0; font-size: 1.125rem; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
	.post-card-title a:hover { color: var(--primary); }
	.description { margin: 0; font-size: 0.8125rem; line-height: 1.7; }
	.project-links { display: flex; flex-wrap: wrap; align-items: center; column-gap: 1rem; row-gap: 0.5rem; margin-top: 0.15rem; }
	.resource-link, .detail-link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; line-height: 1.6; }
	.resource-link { color: var(--primary); font-weight: 600; }
	.resource-link:hover, .detail-link:hover { text-decoration: underline; }
	@media (min-width: 640px) {
		.project-card { grid-template-columns: 140px minmax(0, 1fr); }
	}
	@media (min-width: 1280px) {
		.project-card { grid-template-columns: 180px minmax(0, 1fr); padding: 1.5rem; gap: 1.5rem; }
	}
</style>
