---
import ProjectCard from "@/components/pages/projects/ProjectCard.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import { getFileDirFromPath, removeFileExtension } from "@/utils/url-utils";

if (!siteConfig.pages.projects) return Astro.redirect("/404/");

const projects = await getSortedProjects();
const title = i18n(I18nKey.projects);
---

<MainGridLayout title={title}>
	<section class="flex flex-col gap-4" aria-labelledby="research-title">
		<header class="px-6 py-5">
			<h2 id="research-title" class="text-2xl font-bold">{title}</h2>
		</header>
		{projects.map((project) => (
			<ProjectCard
				id={removeFileExtension(project.id)}
				title={project.data.title}
				authors={project.data.authors}
				venue={project.data.venue}
				authorNotes={project.data.authorNotes}
				description={project.data.description}
				image={project.data.image}
				basePath={getFileDirFromPath(project.filePath || "")}
				link={project.data.link}
			/>
		))}
		{projects.length === 0 && <p class="px-6 py-8 text-neutral-500">{i18n(I18nKey.projectEmpty)}</p>}
	</section>
</MainGridLayout>
