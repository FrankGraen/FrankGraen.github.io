---
import ProjectCard from "@/components/pages/projects/ProjectCard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import "@/styles/banner-home.css";

const projects = await getSortedProjects();
---

<MainGridLayout heading="FrankGraen · Zhexiong Wang">
	<section class="flex flex-col gap-4" aria-labelledby="research-title">
		<h2 id="research-title" class="sr-only">Research</h2>
		{projects.map((project) => (
			<ProjectCard
				id={project.id}
				title={project.data.title}
				authors={project.data.authors}
				venue={project.data.venue}
				authorNotes={project.data.authorNotes}
				description={project.data.description}
				image={project.data.image}
				link={project.data.link}
			/>
		))}
	</section>
</MainGridLayout>
